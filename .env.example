# ============================================================
# Modelo do arquivo .env — copie para ".env" e preencha.
# O .env real nunca é versionado (contém chaves de API).
# ============================================================

# API FIPE (Parallelum v2) — gratuita, até 500 req/dia sem token.
FIPE_API_URL=https://fipe.parallelum.com.br/api/v2
FIPE_API_TOKEN=

# API de imagens — Wikimedia Commons (sem chave).
IMAGE_API_URL=https://commons.wikimedia.org/w/api.php
IMAGE_API_KEY=

# ------------------------------------------------------------
# E-mail de verificação de conta (includes/email.php)
# ------------------------------------------------------------
# Motor: log (desenvolvimento, grava em includes/api/mail.log)
#        mail (função mail() do servidor — HostGator envia sem chave)
#        api (API HTTP, escolher o provedor em MAIL_PROVIDER)
MAIL_DRIVER=log
MAIL_PROVIDER=brevo
MAIL_FROM=nao-responda@gycanic.com.br
MAIL_FROM_NAME=Gycanic

# Chave da API — preencha apenas quando MAIL_DRIVER=api
# Brevo:  https://app.brevo.com/settings/keys-smtp  (grátis, 300 e-mails/dia)
BREVO_API_KEY=
# Resend: https://resend.com/api-keys
RESEND_API_KEY=
